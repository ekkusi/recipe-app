{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "targetDefaults": {
    "dev": {
      "cache": false
    },
    "start": {
      "cache": false
    },
    "build": {
      "cache": true,
      "outputs": [
        "{projectRoot}/.next"
      ]
    }
  },
  "analytics": false
}