{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev":   { "executor": "nx:run-commands", "options": { "command": "npm run dev",   "cwd": "apps/web" } },
    "build": { "executor": "nx:run-commands", "options": { "command": "npm run build", "cwd": "apps/web" } },
    "start": { "executor": "nx:run-commands", "options": { "command": "npm run start", "cwd": "apps/web" } }
  }
}
